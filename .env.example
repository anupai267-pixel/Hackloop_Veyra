# ==========================================
# VEYRA MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and configure real credentials for production or local deployment.
# NEVER commit .env with real secrets to version control.

# --- SERVER CONFIGURATION ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=veyra_dev_session_secret_change_in_production_min_32_chars

# --- DATABASE CONFIGURATION (PostgreSQL + Prisma) ---
# Replace with your PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyra?schema=public"

# --- GOOGLE IDENTITY SERVICES (GIS) AUTHENTICATION ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Web application type with Authorized JavaScript Origins: http://localhost:5173, http://localhost:5000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- PAYMENT GATEWAY CONFIGURATION (Razorpay) ---
# Set to 'test' or 'live'. In test mode without keys, the platform operates in safe simulated test checkout.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# --- WEBRTC SIGNALING & TURN CONFIGURATION ---
# Default uses public STUN servers. For production behind symmetric NAT, provide TURN server credentials.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# --- IMAGE & DOCUMENT STORAGE CONFIGURATION ---
# Storage provider: 'local' (server/uploads) or 's3' / 'gcs'
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- DEFERRED AGENTIC AI INTEGRATION (INTERFACE PLACEHOLDERS) ---
# When core marketplace testing is finalized, configure the chosen LLM provider and agent tools here.
AI_PROVIDER=placeholder
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=your_ai_api_key_placeholder
AI_SERVICE_ENABLED=false
